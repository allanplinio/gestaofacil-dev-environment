# ═══════════════════════════════════════════════════════════════════════════
#  gestaofacil-dev-environment — variáveis do orquestrador
# ═══════════════════════════════════════════════════════════════════════════
#  Copie para .env:   cp .env.example .env
#
#  Este .env configura APENAS o docker-compose (portas, credenciais dos
#  bancos). O .env de cada aplicação continua dentro do próprio projeto.
#  Onde as duas fontes se sobrepõem (DB_HOST, REDIS_HOST...), quem vence é
#  o `environment:` do compose — o Laravel não sobrescreve variável que já
#  existe no ambiente do processo.
# ═══════════════════════════════════════════════════════════════════════════

# ─── Portas publicadas no host ─────────────────────────────────────────────
# Porta única do proxy. Se der "address already in use", algo já ocupa a 80
# (Apache, outro Nginx, ou um docker-proxy órfão). Rode `make doctor`.
HTTP_PORT=80

# ATENÇÃO: 5432 é a porta padrão do PostgreSQL instalado no sistema.
# Se você tem Postgres nativo (`systemctl status postgresql`), use 5442 aqui,
# senão o container não sobe. `make doctor` detecta isso antes do up.
GESTAOFACIL_DB_PORT=5432
NFE_DB_PORT=5433
REDIS_PORT=6379

# ─── Banco: gestaofacil-api ────────────────────────────────────────────────
GESTAOFACIL_DB_DATABASE=gestaofacil
GESTAOFACIL_DB_USERNAME=gestaofacil
GESTAOFACIL_DB_PASSWORD=secret

# ─── Banco: nfe-api ────────────────────────────────────────────────────────
NFE_DB_DATABASE=nfe_api
NFE_DB_USERNAME=nfe_api
NFE_DB_PASSWORD=secret

# ─── NFe / SEFAZ ───────────────────────────────────────────────────────────
# Chave de 32 bytes que criptografa os certificados A1 em repouso.
# DEVE ser diferente da APP_KEY do Laravel. Gere com:
#   php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
# Vazia = a nfe-api falha ao ler/gravar certificado.
NFE_CERT_ENCRYPTION_KEY=

# Gateway da SEFAZ. `fake` NÃO conversa com a SEFAZ: as notas "emitidas"
# são simuladas e não têm validade fiscal nenhuma. Só troque para `real`
# com certificado A1 válido carregado e ciente de que vai bater em
# homologação de verdade (SEFAZ_ENVIRONMENT=2, fixo no compose).
NFE_SEFAZ_GATEWAY=fake
# Busca de notas na SEFAZ (tela Notas na SEFAZ). `false` = a busca fica ativada na tela, mas nada é consultado na SEFAZ.
# `true` gasta a cota real do CNPJ (use uma vez, de forma supervisionada). Depois de mudar: `make up` e `make cache-clear-nfe`.
NFE_DFE_REAL_HABILITADO=false
